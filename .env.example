# Instagram Assistant Configuration
# Copiez ce fichier vers .env et ajustez les chemins selon votre système

# === Chemins Instagram ===
# Dossier de votre export Instagram actuel (messages/inbox)
INSTAGRAM_EXPORT_DIR=/Users/username/Documents/your_instagram_activity/messages/inbox

# Dossier où seront stockés les exports mergés (optionnel)
INSTAGRAM_MERGED_DIR=/Users/username/Documents/instagram_merged/messages/inbox

# === Chemins du projet ===
# Dossier de base du projet (auto-détecté si vide)
BASE_DIR=

# Dossier où sont stockées les conversations converties en texte
CONVERSATIONS_DIR=instagram_conversations

# Dossier où sont stockés les index RAG
INDEX_DIR=rag_data

# === Configuration utilisateur ===
# Votre nom (utilisé dans l'interface)
USER_NAME=Ismaël

# === Configuration LLM ===
# Modèle Ollama à utiliser
LLM_MODEL=qwen3:latest

# URL du serveur Ollama
OLLAMA_URL=http://localhost:11434

# Taille de la fenêtre de contexte Ollama (tokens)
LLM_NUM_CTX=8192

# === Configuration Embeddings ===
# Modèle d'embeddings (recommandé: BAAI/bge-m3 pour multilingue FR/EN)
EMBEDDING_MODEL=BAAI/bge-m3

# Utiliser GPU si disponible (true/false)
USE_GPU=true

# === Configuration RAG ===
# Nombre de chunks à récupérer lors d'une recherche
TOP_K=5

# Score minimum de similarité (0.0 à 1.0)
MIN_SIMILARITY=0.3

# Activer le reranking (true/false)
USE_RERANKING=true

# Activer la recherche hybride dense+BM25 (true/false)
USE_HYBRID=true

# === Configuration Chunking ===
# Nombre max de messages par chunk
CHUNK_MAX_MESSAGES=50

# Durée max d'un chunk en jours
CHUNK_MAX_DAYS=3

# Chevauchement entre chunks (en messages)
CHUNK_OVERLAP=5
